# Varsayilan: her seyi ignore et
*

# Takip edilmesini istediklerimiz
!.gitignore
!template_matching_parallel_processing_560_hizli_solust_sagalt_koordinat_fonksiyonlar_icinde_cursor.py
!konum_ui_qt.py
!mission_ui/*.py
!requirements-ui.txt
!baslat_ui.cmd
!gps_denied_autonomy.py
!optical_flow_speed.py
!pyramid_search.py
# Testleri depoda olan saf-Python moduller ve yardimci giris noktalari
!localization_policy.py
!tracking_filter.py
!experiment_tracking.py
!run_localization.py
!headless/*.py
!headless/requirements-linux.txt
!tools/*.py
!.github/workflows/*.yml
!requirements.txt
!*.md
!*.MD
!**/.gitkeep

# Birim testleri (tests/ klasoru)
!tests/
!tests/**/*.py

# Klasorlerin repoda gorunebilmesi icin klasorleri serbest birak
!*/

# Gecici/onbellek klasorleri yine de ignore
__pycache__/
.ruff_cache/

# Ucus replay (makale: kod, kare bazli kayitlar, manifest) ve makale uretim betikleri (manuscript_v15)
!flight_replay/*.py
!flight_replay/*.bat
!flight_replay/SKIP_EQ1_MODELS.txt
!flight_replay/frame_manifest_exif.csv
!flight_replay/runs_ne/*.csv
!flight_replay/runs/*.csv
!flight_replay/texture_probe_ne/*.csv
!manuscript_v15/*.py
!manuscript_v15/inputs/recon.json
!manuscript_v15/ijeg/*.py
!manuscript_v15/ijeg/refs_apa_v16.txt
!manuscript_v15/ijeg/figs/*.png
!manuscript_v15/out/numbers.json
!manuscript_v15/out/tables/*.csv

# Lisans ve atif dosyalari
!LICENSE-MIT
!LICENSE-APACHE
!CITATION.cff
!.zenodo.json

# Yalniz yerelde kalan calisma notlari (depoya konmaz)
manuscript_v15/DEVAM.md
manuscript_v15/make_response.py
manuscript_v15/response_text.py
